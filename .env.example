# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All database work runs against an isolated, disposable test database.

# --- PostgreSQL connection (the "admin" / maintenance DB used to CREATE/DROP test DBs) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
# Maintenance DB to connect to when creating/dropping the disposable test DB.
PGMAINTENANCE_DB=postgres

# Name of the disposable test database the toolkit creates and seeds.
INDEX_ADVISOR_DB=index_advisor_test

# --- Hugging Face Hub (used from Week 5 to host the fine-tuned Laya checkpoint + datasets) ---
# Leave empty until Week 5. Never commit a real token.
HUGGINGFACE_HUB_TOKEN=
